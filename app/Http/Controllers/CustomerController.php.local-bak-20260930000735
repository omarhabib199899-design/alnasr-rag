    /**
     * Real per-period Collection KPI table, from ar_ledger_entries rows
     * tagged category='COLLECTION' (kpi_amount = the payment amount).
     * Collection Ratio vs Sales and Collection Contribution % compare
     * against the same period's Net Sales / company-wide Collection, same
     * pattern as the Sales tab's Revenue Contribution %. Collection Rank,
     * Volatility % and Average Payment Interval are lifetime-only snapshots
     * passed in already computed (company-wide comparisons, expensive to
     * repeat per period).
     *
     * @return array<string, array<string, string>>
     */
    private function buildCollectionKpiTable(?string $zohoCustomerId, ?int $collectionRank = null, ?float $avgPaymentIntervalDays = null, ?string $collectionVolatility = null): array
    {
        if ($zohoCustomerId === null) {
            return [];
        }

        $money = fn (float $v) => 'SAR '.number_format($v, 0);
        $table = [];

        foreach ($this->periodRanges() as $label => [$from, $to]) {
            $query = ArLedgerEntry::where('zoho_customer_id', $zohoCustomerId)->where('category', 'COLLECTION');
            $companyQuery = ArLedgerEntry::where('category', 'COLLECTION');
            $salesQuery = SalesItemPerformance::where('zoho_customer_id', $zohoCustomerId)->where('transaction_type', 'Invoice');
            if ($from !== null) {
                $query->whereBetween('transaction_date', [$from->toDateString(), $to->toDateString()]);
                $companyQuery->whereBetween('transaction_date', [$from->toDateString(), $to->toDateString()]);
                $salesQuery->whereBetween('transaction_date', [$from->toDateString(), $to->toDateString()]);
            }

            $payments = (clone $query)
                ->select('transaction_number')->selectRaw('SUM(kpi_amount) as total')
                ->groupBy('transaction_number')->pluck('total')
                ->map(fn ($v) => (float) $v)->values();

            $collected = $payments->sum();
            $count = $payments->count();
            $companyCollected = (float) $companyQuery->sum('kpi_amount');
            $netSales = (float) $salesQuery->sum('item_total');

            $sorted = $payments->sort()->values();
            $median = $sorted->isEmpty() ? 0.0 : ($sorted->count() % 2 === 1
                ? $sorted[intdiv($sorted->count(), 2)]
                : ($sorted[$sorted->count() / 2 - 1] + $sorted[$sorted->count() / 2]) / 2);

            $table[$label] = [
                'Collection' => $money($collected),
                'Collection Ratio vs Sales' => $netSales > 0 ? number_format($collected / $netSales * 100, 1).'%' : '—',
                'Payment Count' => number_format($count),
                'Average Payment Value' => $count > 0 ? $money($collected / $count) : '—',
                'Collection Average' => $count > 0 ? $money($collected / $count) : '—',
                'Collection Median' => $count > 0 ? $money($median) : '—',
                'Collection Volatility %' => $label === 'Lifetime' ? ($collectionVolatility ?? '—') : '—',
                'Collection Contribution %' => $companyCollected > 0 ? number_format($collected / $companyCollected * 100, 2).'%' : '—',
                'Collection Rank - Company' => $label === 'Lifetime' && $collectionRank !== null ? '#'.$collectionRank : '—',
                'Largest Payment Value' => $payments->isEmpty() ? '—' : $money($payments->max()),
                'Average Payment Interval' => $label === 'Lifetime' && $avgPaymentIntervalDays !== null ? number_format($avgPaymentIntervalDays, 0).' days' : '—',
            ];
        }

        return $table;
    }

